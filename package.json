{
  "name": "eunonymous-tcg",
  "version": "1.1.0",
  "description": "Eunonymous-TCG — a deck-building battleground trading card game set in the Synthtopia universe. Browser-first (HTML5, no build step) with a built-in LAN multiplayer server for head-to-head play.",
  "main": "server/lan-server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server/lan-server.js",
    "lan": "node server/lan-server.js",
    "serve": "node server/lan-server.js --static-only",
    "test": "node test/run-all.js",
    "test:relay": "node test/lan-server-test.js",
    "test:mirror": "node test/lan-browser-test.js",
    "harness:battle": "node test/battle-test.js"
  },
  "keywords": [
    "tcg",
    "card-game",
    "deckbuilder",
    "battleground",
    "html5",
    "multiplayer",
    "lan"
  ],
  "author": "JetSetVideo",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "puppeteer-core": "^25.3.0",
    "ws": "^8.18.0"
  }
}
